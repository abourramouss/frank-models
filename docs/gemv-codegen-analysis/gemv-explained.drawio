    <!-- Translation box -->
    <mxCell id="s2_meaning" value="&lt;b&gt;What this means:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; size=&quot;2&quot;&gt;workgroup_size=[32,1,1]&lt;/font&gt; = 32 threads/block (1 warp)&lt;br&gt;&lt;font face=&quot;monospace&quot; size=&quot;2&quot;&gt;workgroup=[1,0,0]&lt;/font&gt; = 1 output per block&lt;br&gt;&lt;font face=&quot;monospace&quot; size=&quot;2&quot;&gt;thread=[0,1,8]&lt;/font&gt; = each thread: 8 multiply-adds&lt;br&gt;&lt;font face=&quot;monospace&quot; size=&quot;2&quot;&gt;partial_reduction=[0,32,0]&lt;/font&gt; = 32 threads shuffle-reduce" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1020" y="40" width="330" height="90" as="geometry"/>
    </mxCell>

