    <!-- Speedup callout -->
    <mxCell id="s4_speedup" value="&lt;font size=&quot;5&quot;&gt;&lt;b&gt;65x slower&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;This single issue accounts for the&lt;br&gt;entire gap between IREE (6.1 tok/s)&lt;br&gt;and llama.cpp (49 tok/s)" style="rounded=1;fillColor=#f8cecc;strokeColor=#cc0000;whiteSpace=wrap;fontSize=12;align=center;" vertex="1" parent="1">
      <mxGeometry x="800" y="830" width="500" height="100" as="geometry"/>
    </mxCell>

    <!-- =========================================================== -->
    <!-- SECTION: Data flow detail (between sections 2 and 3) -->
    <!-- =========================================================== -->
    <mxCell id="flow_title" value="&lt;b&gt;How 32 threads reduce 1024 elements (per block):&lt;/b&gt;" style="text;fontSize=12;align=left;fontColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="750" y="510" width="400" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="flow_detail" value="32 threads x 8 elements = 256 per iteration x 4 iterations = 1024 total&lt;br&gt;Then 5 rounds of warp shuffle to combine 32 partial sums into 1 result" style="text;fontSize=10;align=left;fontColor=#999999;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="750" y="530" width="600" height="30" as="geometry"/>
