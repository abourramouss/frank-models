        <mxCell id="decode-call2" value="&lt;b&gt;@decode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;strokeWidth=2;strokeDashPattern=4 4;" vertex="1" parent="1">
          <mxGeometry x="720" y="140" width="100" height="55" as="geometry"/>
