        </mxCell>
        <mxCell id="attn-label" value="&lt;font style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;ATTENTION BLOCK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;fontColor=#2D5F8A;" vertex="1" parent="1">
          <mxGeometry x="75" y="518" width="150" height="16" as="geometry"/>
        </mxCell>

        <mxCell id="a-norm" value="&lt;b&gt;rms_norm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="542" width="80" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="a-qkv" value="&lt;b&gt;Q K V proj&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;×3 same kernel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="175" y="538" width="90" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="a-rope" value="&lt;b&gt;norm+RoPE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="542" width="80" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="a-attn" value="&lt;b&gt;★ attention&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;QK&lt;sup&gt;T&lt;/sup&gt;+softmax+AV&lt;br&gt;FUSED 1 dispatch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="375" y="535" width="105" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="a-oproj" value="&lt;b&gt;O proj&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;+ residual (fused)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="495" y="538" width="95" height="38" as="geometry"/>
        </mxCell>

        <!-- Attention flow arrows -->
        <mxCell id="aa1" style="strokeColor=#999;strokeWidth=1;" edge="1" source="a-norm" target="a-qkv" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aa2" style="strokeColor=#999;strokeWidth=1;" edge="1" source="a-qkv" target="a-rope" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aa3" style="strokeColor=#999;strokeWidth=1;" edge="1" source="a-rope" target="a-attn" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aa4" style="strokeColor=#999;strokeWidth=1;" edge="1" source="a-attn" target="a-oproj" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Attention scaling callouts -->
        <mxCell id="a-attn-scale" value="&lt;font style=&quot;font-size:8px;color:#b85450;&quot;&gt;prefill: &lt;b&gt;S×S&lt;/b&gt; attention matrix&lt;br&gt;decode: 1×&lt;b&gt;ctx_len&lt;/b&gt; (grows each step)&lt;br&gt;no flash attention!&lt;/font&gt;" style="text;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="370" y="583" width="180" height="40" as="geometry"/>
        </mxCell>

        <!-- KV cache -->
        <mxCell id="kv-cache" value="&lt;b&gt;KV cache scatter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#ff9800;&quot;&gt;⚠ &lt;code&gt;slow_memcpy&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="610" y="535" width="120" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="aa5" style="strokeColor=#999;strokeWidth=1;" edge="1" source="a-oproj" target="kv-cache" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="kv-scale" value="&lt;font style=&quot;font-size:8px;color:#d6b656;&quot;&gt;prefill: loops &lt;b&gt;S&lt;/b&gt; times → 4S dispatches!&lt;br&gt;decode: 2 dispatches (1 token)&lt;/font&gt;" style="text;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="600" y="575" width="200" height="28" as="geometry"/>
        </mxCell>

        <!-- Decode-only: KV gather -->
        <mxCell id="kv-gather" value="&lt;b&gt;KV gather&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#ff9800;&quot;&gt;decode only: &lt;code&gt;slow_memcpy&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="748" y="535" width="90" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="aa6" style="strokeColor=#d6b656;strokeWidth=1;dashed=1;" edge="1" source="kv-cache" target="kv-gather" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- MoE sub-block -->
        <mxCell id="moe-box" value="" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=40;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="65" y="700" width="780" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="moe-label" value="&lt;font style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;MoE FFN BLOCK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;fontColor=#8B6D1F;" vertex="1" parent="1">
          <mxGeometry x="75" y="703" width="150" height="16" as="geometry"/>
        </mxCell>

        <mxCell id="m-norm" value="&lt;b&gt;rms_norm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="730" width="80" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m-router" value="&lt;b&gt;router&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;softmax+topk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="178" y="726" width="80" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="m-gather" value="&lt;b&gt;★ gather&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;8 expert wts&lt;br&gt;×3 (g/u/d)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="275" y="722" width="90" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="m-ffn" value="&lt;b&gt;★ expert FFN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;gate→swiglu→down&lt;br&gt;&lt;b&gt;D = 8×S&lt;/b&gt; matmuls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="383" y="722" width="110" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="m-sum" value="&lt;b&gt;weighted&lt;br&gt;sum&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;+ residual&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="510" y="722" width="75" height="46" as="geometry"/>
        </mxCell>

        <!-- MoE flow arrows -->
        <mxCell id="ma1" style="strokeColor=#999;strokeWidth=1;" edge="1" source="m-norm" target="m-router" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ma2" style="strokeColor=#999;strokeWidth=1;" edge="1" source="m-router" target="m-gather" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ma3" style="strokeColor=#999;strokeWidth=1;" edge="1" source="m-gather" target="m-ffn" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ma4" style="strokeColor=#999;strokeWidth=1;" edge="1" source="m-ffn" target="m-sum" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- MoE scaling callout -->
        <mxCell id="m-scale" value="&lt;font style=&quot;font-size:8px;color:#b85450;&quot;&gt;prefill S=1024: gather creates &lt;b&gt;[8192, 1024, 2048]&lt;/b&gt;&lt;br&gt;= ~67 GB gathered weights per layer!&lt;br&gt;decode: [8, 1024, 2048] — tiny, &lt;b&gt;memory-bound&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="355" y="772" width="260" height="40" as="geometry"/>
        </mxCell>

        <!-- MoE data-dependent callout -->
        <mxCell id="m-datadep" value="&lt;font style=&quot;font-size:8px;color:#8B6D1F;&quot;&gt;WHICH 8 of 64 experts → &lt;b&gt;data-dependent values&lt;/b&gt;&lt;br&gt;but the SHAPE is always [8×tokens, ...]  → &lt;b&gt;fixed allocation&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="772" width="280" height="30" as="geometry"/>
        </mxCell>

        <!-- Loopback arrow from end of MoE to next layer -->
        <mxCell id="loop-back" value="&lt;font style=&quot;font-size:8px;color:#8B6D1F;&quot;&gt;next layer →&lt;/font&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
