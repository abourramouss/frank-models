        <!-- arrows in python layer -->
        <mxCell id="arr-p1" style="strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="prefill-call" target="argmax1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-p2" style="strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="argmax1" target="decode-call1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-p3" style="strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="decode-call1" target="argmax2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-p4" style="strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="argmax2" target="decode-call2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr-eos" style="strokeColor=#b85450;strokeWidth=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="decode-call2" target="eos" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Python updates label -->
        <mxCell id="py-updates" value="&lt;font style=&quot;font-size:9px;&quot;&gt;Between each invocation Python does:&lt;br&gt;&lt;code&gt;pos += 1&lt;/code&gt;, &lt;code&gt;ctx_lens += 1&lt;/code&gt;, &lt;code&gt;next_tok = argmax(logits)&lt;/code&gt;&lt;br&gt;Then passes these as &lt;b&gt;concrete inputs&lt;/b&gt; to the next MLIR call.&lt;/font&gt;" style="text;html=1;align=left;fontColor=#2D6A2E;" vertex="1" parent="1">
          <mxGeometry x="60" y="225" width="450" height="45" as="geometry"/>
        </mxCell>

        <!-- Zoom-in arrow from @prefill/@decode to Layer 2 -->
        <mxCell id="zoom-label" value="&lt;font style=&quot;font-size:10px;&quot;&gt;Each @prefill / @decode call is &lt;b&gt;one IREE invocation&lt;/b&gt;.&lt;br&gt;Inside, the VM sequences ~500-66000 dispatches ↓&lt;/font&gt;" style="text;html=1;align=center;fontColor=#555;" vertex="1" parent="1">
          <mxGeometry x="200" y="280" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="zoom-arrow" style="strokeColor=#555;strokeWidth=2;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="315" as="sourcePoint"/>
            <mxPoint x="440" y="360" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ============================================================ -->
        <!-- LAYER 2: IREE VM SEQUENCING                                  -->
        <!-- ============================================================ -->
        <mxCell id="vm-band" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=25;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="360" width="840" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="vm-label" value="&lt;font style=&quot;font-size:14px;&quot;&gt;&lt;b&gt;LAYER 2: IREE VM&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;Handles &lt;b&gt;input-dependent&lt;/b&gt; dynamism (~ns)&lt;br&gt;&lt;code&gt;tensor&amp;lt;?x?xf32&amp;gt;&lt;/code&gt; dims resolved from input shapes &lt;b&gt;before&lt;/b&gt; first dispatch&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#2D5F8A;" vertex="1" parent="1">
          <mxGeometry x="45" y="365" width="400" height="55" as="geometry"/>
        </mxCell>

        <!-- The VM dispatch sequence as a simple flow -->
        <mxCell id="embed" value="&lt;b&gt;embed&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="80" height="35" as="geometry"/>
        </mxCell>

        <!-- Layer loop box -->
