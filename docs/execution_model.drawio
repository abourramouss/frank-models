            <mxPoint x="680" y="745" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="630" y="730"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Connection: embed to attn -->
        <mxCell id="e2a" style="strokeColor=#999;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="465" as="sourcePoint"/>
            <mxPoint x="100" y="515" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

