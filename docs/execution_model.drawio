        <!-- Output proj -->
        <mxCell id="output-proj" value="&lt;b&gt;final_norm + output_proj&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;→ logits [&lt;font color=&quot;#e6194B&quot;&gt;S&lt;/font&gt;, 50304]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="o2o" style="strokeColor=#999;strokeWidth=1;" edge="1" parent="1">
