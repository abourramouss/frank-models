<mxfile host="app.diagrams.net" modified="2026-03-13" type="device">
  <diagram name="Execution Flow" id="exec-flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ============ TITLE ============ -->
        <mxCell id="title" value="&lt;font style=&quot;font-size:18px;&quot;&gt;&lt;b&gt;IREE LLM Execution Flow&lt;/b&gt; — OLMoE-1B-7B&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- LAYER 1: PYTHON HOST                                         -->
        <!-- ============================================================ -->
        <mxCell id="py-band" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=30;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="840" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="py-label" value="&lt;font style=&quot;font-size:14px;&quot;&gt;&lt;b&gt;LAYER 1: PYTHON HOST&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;Handles &lt;b&gt;data-dependent&lt;/b&gt; dynamism (~μs)&lt;br&gt;argmax, EOS check, position tracking&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#2D6A2E;" vertex="1" parent="1">
          <mxGeometry x="45" y="65" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- Prefill box -->
        <mxCell id="prefill-call" value="&lt;font style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;@prefill&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-family:monospace;&quot;&gt;tokens[1, &lt;font color=&quot;#e6194B&quot;&gt;&lt;b&gt;S&lt;/b&gt;&lt;/font&gt;], positions[1, &lt;font color=&quot;#e6194B&quot;&gt;&lt;b&gt;S&lt;/b&gt;&lt;/font&gt;]&lt;br&gt;cache, block_tables&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#888;&quot;&gt;→ logits[1, &lt;font color=&quot;#e6194B&quot;&gt;S&lt;/font&gt;, 50304]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="175" height="75" as="geometry"/>
        </mxCell>

        <!-- argmax 1 -->
        <mxCell id="argmax1" value="&lt;b&gt;argmax&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;Python&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="275" y="135" width="80" height="65" as="geometry"/>
        </mxCell>

        <!-- Decode box 1 -->
        <mxCell id="decode-call1" value="&lt;font style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;@decode&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-family:monospace;&quot;&gt;token[1], position[1]&lt;br&gt;cache, ctx_lens[16,1]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#888;&quot;&gt;→ logits[1, 50304]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="395" y="130" width="165" height="75" as="geometry"/>
        </mxCell>

        <!-- argmax 2 -->
        <mxCell id="argmax2" value="&lt;b&gt;argmax&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;Python&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="600" y="135" width="80" height="65" as="geometry"/>
        </mxCell>

