            <mxPoint x="350" y="920" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="return-label" value="&lt;font style=&quot;font-size:9px;color:#2D6A2E;&quot;&gt;logits → Python → argmax → next @decode call&lt;/font&gt;" style="text;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="360" y="912" width="300" height="16" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- Zoom into a single dispatch → LAYER 3                        -->
        <!-- ============================================================ -->
        <mxCell id="sched-zoom" value="&lt;font style=&quot;font-size:10px;&quot;&gt;Each box above = 1+ &lt;b&gt;dispatches&lt;/b&gt;. Each dispatch is tiled for parallel execution ↓&lt;/font&gt;" style="text;html=1;align=center;fontColor=#555;" vertex="1" parent="1">
          <mxGeometry x="175" y="965" width="450" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="sched-arrow" style="strokeColor=#555;strokeWidth=2;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="990" as="sourcePoint"/>
            <mxPoint x="440" y="1020" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="sched-band" value="" style="rounded=1;fillColor=#E8D5F5;strokeColor=#9673a6;opacity=30;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="1020" width="840" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="sched-label" value="&lt;font style=&quot;font-size:14px;&quot;&gt;&lt;b&gt;LAYER 3: WORK-STEALING SCHEDULER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;Handles &lt;b&gt;computational&lt;/b&gt; parallelism (~ms)&lt;br&gt;Same scheduler for CPU threads, GPU warps, NPU tiles&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#7B4F9E;" vertex="1" parent="1">
          <mxGeometry x="45" y="1025" width="400" height="55" as="geometry"/>
        </mxCell>

        <!-- Example: one dispatch tiled -->
        <mxCell id="dispatch-example" value="&lt;font style=&quot;font-size:10px;&quot;&gt;Example: &lt;b&gt;Q projection dispatch&lt;/b&gt; = matmul [S, 2048] × [2048, 2048]&lt;/font&gt;" style="text;html=1;align=center;fontColor=#7B4F9E;" vertex="1" parent="1">
          <mxGeometry x="150" y="1080" width="500" height="18" as="geometry"/>
        </mxCell>

        <!-- Dispatch box -->
        <mxCell id="dispatch-box" value="&lt;font style=&quot;font-size:10px;font-family:monospace;&quot;&gt;dispatch_17: batch_matmul_DxDx2048x2048&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8D5F5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="1105" width="320" height="30" as="geometry"/>
        </mxCell>

        <!-- Tiling arrow -->
        <mxCell id="tile-arrow" value="&lt;font style=&quot;font-size:9px;color:#7B4F9E;&quot;&gt;tile into work items&lt;/font&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="1108" width="120" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="tile-arr" style="strokeColor=#9673a6;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="1135" as="sourcePoint"/>
            <mxPoint x="320" y="1160" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Work items grid -->
        <mxCell id="tile0" value="&lt;font style=&quot;font-size:7px;&quot;&gt;tile&lt;br&gt;(0,0)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8D5F5;strokeColor=#9673a6;fontSize=7;" vertex="1" parent="1">
          <mxGeometry x="80" y="1160" width="55" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="tile1" value="&lt;font style=&quot;font-size:7px;&quot;&gt;tile&lt;br&gt;(0,1)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8D5F5;strokeColor=#9673a6;fontSize=7;" vertex="1" parent="1">
          <mxGeometry x="135" y="1160" width="55" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="tile2" value="&lt;font style=&quot;font-size:7px;&quot;&gt;tile&lt;br&gt;(0,2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8D5F5;strokeColor=#9673a6;fontSize=7;" vertex="1" parent="1">
          <mxGeometry x="190" y="1160" width="55" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="tile3" value="&lt;font style=&quot;font-size:7px;&quot;&gt;tile&lt;br&gt;(0,3)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8D5F5;strokeColor=#9673a6;fontSize=7;" vertex="1" parent="1">
          <mxGeometry x="245" y="1160" width="55" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="tile4" value="&lt;font style=&quot;font-size:7px;&quot;&gt;tile&lt;br&gt;(1,0)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8D5F5;strokeColor=#9673a6;fontSize=7;" vertex="1" parent="1">
          <mxGeometry x="300" y="1160" width="55" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="tile5" value="&lt;font style=&quot;font-size:7px;&quot;&gt;tile&lt;br&gt;(1,1)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8D5F5;strokeColor=#9673a6;fontSize=7;" vertex="1" parent="1">
          <mxGeometry x="355" y="1160" width="55" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="tile-dots" value="&lt;font style=&quot;font-size:10px;&quot;&gt;. . .&lt;/font&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="415" y="1165" width="40" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="tile-n" value="&lt;font style=&quot;font-size:7px;&quot;&gt;tile&lt;br&gt;(M,N)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8D5F5;strokeColor=#9673a6;fontSize=7;" vertex="1" parent="1">
          <mxGeometry x="460" y="1160" width="55" height="35" as="geometry"/>
        </mxCell>

        <!-- Worker threads -->
        <mxCell id="steal-label" value="&lt;font style=&quot;font-size:9px;color:#7B4F9E;&quot;&gt;worker threads &lt;b&gt;steal&lt;/b&gt; from shared queue — no thread idle while work remains&lt;/font&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="1200" width="420" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="steal-arrows" style="strokeColor=#9673a6;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="1218" as="sourcePoint"/>
            <mxPoint x="280" y="1240" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="t0" value="&lt;font style=&quot;font-size:8px;&quot;&gt;&lt;b&gt;T0&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#fff;strokeColor=#7B4F9E;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="1240" width="45" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="&lt;font style=&quot;font-size:8px;&quot;&gt;&lt;b&gt;T1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#fff;strokeColor=#7B4F9E;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="130" y="1240" width="45" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="&lt;font style=&quot;font-size:8px;&quot;&gt;&lt;b&gt;T2&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#fff;strokeColor=#7B4F9E;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="1240" width="45" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;font style=&quot;font-size:8px;&quot;&gt;&lt;b&gt;T3&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#fff;strokeColor=#7B4F9E;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="230" y="1240" width="45" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="t-dots" value="&lt;font style=&quot;font-size:10px;&quot;&gt;. . .&lt;/font&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="1240" width="40" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="tN" value="&lt;font style=&quot;font-size:8px;&quot;&gt;&lt;b&gt;TN&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#fff;strokeColor=#7B4F9E;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="325" y="1240" width="45" height="25" as="geometry"/>
        </mxCell>

        <!-- Backend callout -->
        <mxCell id="backend" value="&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;b&gt;Same scheduler, any backend:&lt;/b&gt;&lt;br&gt;CPU → threads steal tiles across cores&lt;br&gt;GPU → workgroups map to SMs/CUs&lt;br&gt;NPU → tiles map to compute units&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8D5F5;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="1130" width="260" height="65" as="geometry"/>
        </mxCell>

        <!-- Scheduler key insight -->
        <mxCell id="sched-insight" value="&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;b&gt;The multiplier:&lt;/b&gt; a matmul that takes 10ms on 1 core&lt;br&gt;takes ~10ms/N on N cores. This applies to &lt;b&gt;every&lt;/b&gt; dispatch —&lt;br&gt;attention, MoE, norms — the scheduler doesn't know the difference.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8D5F5;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="1210" width="280" height="55" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- DISPATCH COUNT + WHERE IT BREAKS                             -->
        <!-- ============================================================ -->
        <mxCell id="numbers-title" value="&lt;font style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;Where It Breaks at Scale&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="230" y="1350" width="300" height="20" as="geometry"/>
        </mxCell>

        <!-- Prefill costs -->
        <mxCell id="cost-prefill" value="&lt;div style=&quot;text-align:left;padding:6px;&quot;&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Prefill (S tokens, 16 layers)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;★ &lt;b&gt;Attention:&lt;/b&gt; S×S scores (no flash)&lt;br&gt;&amp;nbsp;&amp;nbsp;S=4096 → 16M float attention matrix / head&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;⚠ &lt;b&gt;KV scatter:&lt;/b&gt; 4S slow_memcpy dispatches / layer&lt;br&gt;&amp;nbsp;&amp;nbsp;S=1024 → 65536 extra dispatches total!&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;★ &lt;b&gt;MoE gather:&lt;/b&gt; [8S, embd, ff] intermediates&lt;br&gt;&amp;nbsp;&amp;nbsp;S=1024 → ~67 GB gathered weights / layer&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#b85450;align=left;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="1380" width="370" height="175" as="geometry"/>
        </mxCell>

        <!-- Decode costs -->
        <mxCell id="cost-decode" value="&lt;div style=&quot;text-align:left;padding:6px;&quot;&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Decode (1 token, 16 layers)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;Fixed ~643 dispatches&lt;/b&gt; (no S scaling)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;★ &lt;b&gt;Attention:&lt;/b&gt; reads growing ctx_len KV entries&lt;br&gt;&amp;nbsp;&amp;nbsp;memory bandwidth cost grows linearly&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#999&quot;&gt;★ &lt;b&gt;All matmuls are GEMV:&lt;/b&gt; [1, 2048] × [2048, N]&lt;br&gt;&amp;nbsp;&amp;nbsp;memory-bound, not compute-bound&lt;br&gt;&amp;nbsp;&amp;nbsp;poor utilization of parallel cores&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#6c8ebf;align=left;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="1380" width="380" height="175" as="geometry"/>
        </mxCell>

        <!-- Kernel reuse note -->
        <mxCell id="reuse-note" value="&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;b&gt;Kernel reuse:&lt;/b&gt; 8+ dispatch kernels compiled once, shared between prefill &amp;amp; decode.&lt;br&gt;Same code, different &lt;code&gt;D&lt;/code&gt; value at invocation time — that's the &lt;code&gt;tensor&amp;lt;?x?xf32&amp;gt;&lt;/code&gt; mechanism.&lt;/font&gt;" style="text;html=1;align=center;fontColor=#555;" vertex="1" parent="1">
          <mxGeometry x="100" y="1565" width="650" height="28" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
