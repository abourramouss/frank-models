        </mxCell>
        <mxCell id="loop-label" value="&lt;font style=&quot;font-size:11px;color:#8B6D1F;&quot;&gt;&lt;b&gt;scf.for layer = 0..15&lt;/b&gt; (16 iterations, not unrolled)&lt;/font&gt;" style="text;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="488" width="350" height="18" as="geometry"/>
        </mxCell>

        <!-- ATTENTION sub-block -->
